{
  "name": "agentic-ta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run env && npm run db:init && npm run setup:agents",
    "setup:agents": "cd agents && node ../scripts/uv.mjs sync",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "tsx watch backend/server.ts",
    "dev:frontend": "cd frontend && vite",
    "dev:agents": "cd agents && node ../scripts/uv.mjs run uvicorn app.main:app --reload --port 8000",
    "build": "cd frontend && vite build",
    "preview": "cd frontend && vite preview",
    "start": "npm run db:init && node --import tsx backend/server.ts",
    "db:init": "node --import tsx backend/db/init-db.ts",
    "db:reset": "node --import tsx backend/db/init-db.ts --reset",
    "db:seed-metrics": "node --import tsx backend/db/seed-metrics.ts",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test:agents": "cd agents && node ../scripts/uv.mjs run pytest -q",
    "env": "node scripts/init-env.mjs",
    "sample-course": "cd agents && node ../scripts/uv.mjs run python sample_data/build_sample_course.py",
    "eval:filing": "cd agents && node ../scripts/uv.mjs run python evals/filing_eval.py"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.73.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.22",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
