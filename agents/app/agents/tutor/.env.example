# Tutor agent settings (owner: Will).
# Copied to .env by `npm run setup`.  Never commit .env.
# Keys here are used only by this agent.  Leave one blank to fall back to the project .env.

# used by main: openai/gpt-6.2-sol
OPENAI_API_KEY=

# ---- Optional personal overrides (experiments; nothing here is shared)
# Try a different model without editing the shared agents/config.yaml:
# MODEL_MAIN=openai:gpt-6.2-sol
# Send this agent's traces to a different LangSmith project:
# LANGSMITH_PROJECT=agentic-ta-tutor-experiments

# No key for OpenAI? Use Gemini for the tutor and the explain-back judge (key here or in the project .env):
# MODEL_MAIN=google_genai:gemini-3.5-flash-lite
# GOOGLE_API_KEY=
# Force the no-AI tutor and judge (demos, tests):
# AGENTICTA_TUTOR_OFFLINE=1
