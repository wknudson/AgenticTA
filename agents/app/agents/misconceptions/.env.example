# Misconception finder agent settings (owner: Teammate B).
# Copied to .env by `npm run setup`.  Never commit .env.
# Keys here are used only by this agent.  Leave one blank to fall back to the project .env.

# used by baseline: anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=

# Local model server (install Ollama, then: ollama pull phi3)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Optional personal overrides (experiments; nothing here is shared)
# Try a different model without editing the shared agents/config.yaml:
# MODEL_LOCAL=ollama:phi3
# MODEL_BASELINE=anthropic:claude-haiku-5-5
# Send this agent's traces to a different LangSmith project:
# LANGSMITH_PROJECT=agentic-ta-misconceptions-experiments
