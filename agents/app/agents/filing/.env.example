# Filing pipeline agent settings (owner: Will).
# Copied to .env by `npm run setup`.  Never commit .env.
# Keys here are used only by this agent.  Leave one blank to fall back to the project .env.

# used by labeler: google_genai/gemini-3.6-flash, labeler_fallback: google_genai/gemini-3.5-flash-lite
GOOGLE_API_KEY=

# The embeddings for semantic search also use GOOGLE_API_KEY.

# ---- Optional personal overrides (experiments; nothing here is shared)
# Try a different model without editing the shared agents/config.yaml:
# MODEL_LABELER=google_genai:gemini-3.6-flash
# MODEL_LABELER_FALLBACK=google_genai:gemini-3.5-flash-lite
# Send this agent's traces to a different LangSmith project:
# LANGSMITH_PROJECT=agentic-ta-filing-experiments
