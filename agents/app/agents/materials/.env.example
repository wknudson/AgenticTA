# Materials update agent settings (owner: Teammate C).
# Copied to .env by `npm run setup`.  Never commit .env.
# Keys here are used only by this agent.  Leave one blank to fall back to the project .env.

# used by planner: anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
# used by editor: openai/gpt-6-luna
OPENAI_API_KEY=

# ---- Optional personal overrides (experiments; nothing here is shared)
# Try a different model without editing the shared agents/config.yaml:
# MODEL_PLANNER=anthropic:claude-sonnet-5-5
# MODEL_EDITOR=openai:gpt-6-luna
# Send this agent's traces to a different LangSmith project:
# LANGSMITH_PROJECT=agentic-ta-materials-experiments
