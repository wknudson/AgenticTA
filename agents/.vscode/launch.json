{
  // Uses the interpreter selected for this folder (agents/.venv).
  "version": "0.2.0",
  "configurations": [
    {
      // No --reload, so breakpoints work.  Restart (Ctrl+Shift+F5) after code changes.
      "name": "Agents API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Agents tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    }
  ]
}
