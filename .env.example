# Copy to .env (never commit .env).  One file for Express AND the Python agents.

# ---- App
PORT=3001
NODE_ENV=development
# SQLite file shared by Express and the agents (relative to the repo root)
SQLITE_DB_PATH=data/agenticta.sqlite

# ---- Model providers (leave blank the ones you don't have; offline demos work without any)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Model for the original Express AI features (question generation, tutor chat, grading)
EXPRESS_AI_MODEL=gpt-6.2-sol
# Ollama needs no key: install it, run `ollama pull phi3` (or the model in agents/config.yaml)

# ---- LangSmith (shared team workspace; every agent logs to its own project)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Optional (defaults exist in code for local dev)
# JWT_SECRET=change-me
# STUDENT_JWT_SECRET=change-me
# STUDENT_JWT_EXPIRES_IN=8h
# ADMIN_JWT_SECRET=change-me
# ADMIN_JWT_EXPIRES_IN=12h
