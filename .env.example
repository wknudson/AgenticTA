# PROJECT-WIDE settings.  Copied to .env by `npm run setup` (never commit .env).
#
# Each agent also has its own .env for its model keys:
#   agents/app/agents/<agent>/.env      (template: .env.example in the same folder)
# A key placed here works as a fallback for every agent that doesn't set its own.

# ---- LangSmith (one shared team workspace; every agent traces to its own project)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- App
PORT=3001
NODE_ENV=development
# SQLite file shared by Express and the agents (relative to the repo root)
SQLITE_DB_PATH=data/agenticta.sqlite

# ---- The original Express AI features (assignment question generation, tutor chat, grading)
OPENAI_API_KEY=
EXPRESS_AI_MODEL=gpt-6.2-sol

# ---- Optional fallbacks for agents without their own key (uncomment to share one key)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Optional (defaults exist in code for local dev)
# JWT_SECRET=change-me
# STUDENT_JWT_SECRET=change-me
# STUDENT_JWT_EXPIRES_IN=8h
# ADMIN_JWT_SECRET=change-me
# ADMIN_JWT_EXPIRES_IN=12h
